    {
      "start_ms": 100520,
      "end_ms": 107520,
      "start_time": "01:40.52",
      "end_time": "01:47.52",
      "text": "優しいだけじゃ守れないものがある？ わかってるけど"
    },
    {
      "start_ms": 107990,
      "end_ms": 111730,
      "start_time": "01:47.99",
      "end_time": "01:51.73",
      "text": "水面下で絡まる善悪 透けて見える偽善に天罰"
    },
    {
      "start_ms": 111730,
      "end_ms": 112820,
      "start_time": "01:51.73",
      "end_time": "01:52.82",
      "text": "Tell me why, Tell me why, Tell me why, Tell me..."
    },
    {
      "start_ms": 112820,
      "end_ms": 115070,
      "start_time": "01:52.82",
      "end_time": "01:55.07",
      "text": "I don't need you!"
    },
    {
      "start_ms": 115070,
      "end_ms": 120690,
      "start_time": "01:55.07",
      "end_time": "02:00.69",
      "text": "逸材の花より 挑み続け咲いた一輪が美しい"
